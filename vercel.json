{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run --prefix frontend build",
  "outputDirectory": "frontend/build",
  "installCommand": "npm install --prefix frontend",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
